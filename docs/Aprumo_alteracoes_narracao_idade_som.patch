+
+/** Verificação de elegibilidade para o ambiente infantil; o profissional pode usar o catálogo integral em supervisão. */
+export function isGameAgeAppropriate(ageMonths: number, ageRangeMonths: readonly [number, number]): boolean {
+  return ageMonths >= ageRangeMonths[0] && ageMonths <= ageRangeMonths[1];
+}
