+/** Roteiros de acolhimento antes do jogo. Voz sempre opcional e por ação do usuário. */
+export interface GameIntroduction {
+  world: string;
+  mission: string;
+  howToPlay: string;
+  therapistTip: string;
+}
+
+export const GAME_INTRODUCTIONS: Record<string, GameIntroduction> = {
+  'bolhas-magicas': { world: 'Jardim das Bolhas', mission: 'Vamos fazer bolhas brilhantes!', howToPlay: 'Toque nas bolhas para brincar. Quando quiser mais, peça para o adulto ajudar você a dizer: mais bolhas, por favor!', therapistTip: 'Modele pedidos funcionais; não exija fala oral para liberar reforço.' },
+  'escolha-pela-instrucao': { world: 'Missão Instrução', mission: 'Vamos descobrir o que a voz está pedindo!', howToPlay: 'Ouça com atenção. Depois toque na figura certa. Se precisar, use o botão para ouvir outra vez.', therapistTip: 'Diferencie repetição da instrução de dicas; registre os níveis de ajuda.' },
+  'fazendinha-sonora': { world: 'Fazendinha Sonora', mission: 'Os animais querem brincar com você!', howToPlay: 'Toque nas abas e nos animais para descobrir sons e pequenas surpresas. Mostre ao adulto o que você mais gostou.', therapistTip: 'Priorize atenção compartilhada e oportunidades naturais de comunicação.' },
+  'leitura-de-cena': { world: 'Leitura de Cena', mission: 'Toda imagem esconde uma história!', howToPlay: 'Observe as pessoas, os objetos e o lugar. Escute a pergunta e escolha a pista que ajuda a entender o que aconteceu.', therapistTip: 'Explore múltiplas interpretações plausíveis, sem transformar inferência social em diagnóstico.' },
+  'encontre-o-igual': { world: 'Match Lab', mission: 'Vamos encontrar os pares!', howToPlay: 'Veja a figura modelo. Procure a que combina com ela e toque na sua escolha. Pode olhar com calma!', therapistTip: 'Controle campo de comparação, posições e nível de dica.' },
+  'encaixa-ai': { world: 'Encaixa Aí', mission: 'Cada peça tem um lugar especial!', howToPlay: 'Escolha uma peça e leve-a até o espaço com a mesma forma. Solte quando ela estiver bem perto.', therapistTip: 'Ofereça alternativa de toque para selecionar e posicionar quando arrastar for difícil.' },
+  'organize-categoria': { world: 'Organize por Categoria', mission: 'Vamos colocar cada coisa no seu lugar!', howToPlay: 'Olhe o objeto e descubra onde ele combina melhor. Arraste ou toque para escolher o lugar certo.', therapistTip: 'Progrida de categorias concretas a relações funcionais; evite distratores ambíguos.' },
+  'memoria-bichos': { world: 'Memória dos Bichos', mission: 'Os bichinhos estão brincando de esconder!', howToPlay: 'Observe as cartas. Vire duas de cada vez e tente encontrar dois bichinhos iguais. Se não acertar, tudo bem: tente de novo!', therapistTip: 'Ajuste pares e tempo de observação para não confundir memória com destreza motora.' },
+  'par-perfeito': { world: 'Par Perfeito', mission: 'Olhe, compare e encontre!', howToPlay: 'Observe a imagem e escolha outra que seja igual. Você pode experimentar quantas vezes precisar.', therapistTip: 'Alinhe o tipo de pareamento ao programa e à hierarquia de ajuda.' },
+  'cada-um-no-seu-pote': { world: 'Cada Um no Seu Pote', mission: 'Os potes precisam de ajuda!', howToPlay: 'Pegue os objetos e organize nos potes combinando as cores, formas ou tipos de objeto. Pode ir um de cada vez!', therapistTip: 'Separe exigência cognitiva de exigência de precisão do arrasto.' },
+  'detetive-das-emocoes': { world: 'Detetive das Emoções', mission: 'Vamos investigar pistas sobre sentimentos!', howToPlay: 'Observe o rosto, o corpo e a situação. Escolha uma possibilidade e descubra mais pistas. Pessoas podem sentir coisas diferentes na mesma situação.', therapistTip: 'Evite ensinar que uma expressão facial sempre indica uma única emoção.' },
+  'olha-comigo': { world: 'Olha Comigo', mission: 'Olhar juntos pode mostrar coisas incríveis!', howToPlay: 'O amigo vai olhar ou apontar para alguma coisa. Acompanhe a indicação e toque no que vocês encontrarem.', therapistTip: 'Não condicione o reforço a contato ocular; aceite outras formas de atenção conjunta.' },
+  'minha-vez-sua-vez': { world: 'Minha Vez, Sua Vez', mission: 'Vamos construir juntos!', howToPlay: 'Veja de quem é a vez. Quando aparecer sua vez, coloque uma peça. Depois espere o parceiro jogar.', therapistTip: 'Use parceiro real quando possível, com intervalo de espera ajustável.' },
+  'social-city': { world: 'Social City', mission: 'Explore a cidade e escolha seu caminho!', howToPlay: 'Converse com personagens em situações da vida cotidiana. Leia ou escute as opções e escolha como prefere responder. Você pode comparar possibilidades.', therapistTip: 'Ofereça escolhas legítimas e respeite estilos comunicativos diversos.' },
+  'mutirao-do-parque': { world: 'Mutirão do Parque', mission: 'O parque precisa de uma equipe!', howToPlay: 'Explore o parque, veja o que precisa ser feito e combine tarefas com os personagens. Cada pessoa pode colaborar de um jeito.', therapistTip: 'Permita cooperação sem obrigar respostas sociais padronizadas.' },
+  'espelho-magico': { world: 'Espelho Mágico', mission: 'Que tal inventar movimentos?', howToPlay: 'Veja o movimento do personagem e faça do seu jeito. O adulto pode ajudar a registrar como foi a brincadeira.', therapistTip: 'Adapte a ação às possibilidades motoras; não inferir execução física pelo toque.' },
+  'tambor-da-imitacao': { world: 'Tambor da Imitação', mission: 'O Tico quer formar uma dupla musical!', howToPlay: 'Escute o ritmo do Tico. Quando chegar sua vez, toque no tambor para responder.', therapistTip: 'Considere latência e volume, com opção de sequência simplificada.' },
+  'siga-o-mestre': { world: 'Siga o Mestre', mission: 'Você conhece o segredo do mestre?', howToPlay: 'Escute com atenção. Só faça a ação quando a frase começar com: o mestre mandou. Quando ele não mandar, pode esperar!', therapistTip: 'Adapte velocidade, tempo de resposta e exigência de controle inibitório.' },
+  'danca-do-congelar': { world: 'Dança do Congelar', mission: 'Hora de dançar e virar estátua!', howToPlay: 'Quando a música tocar, você pode se mexer. Quando ela parar, tente congelar! Vale adaptar o movimento ao seu corpo.', therapistTip: 'Ofereça modalidade sem movimento corporal e controle sensorial de música.' },
+  'banda-do-tico': { world: 'Banda do Tico', mission: 'Prepare seu show de música!', howToPlay: 'Experimente instrumentos, descubra sons e acompanhe o ritmo quando quiser. Vamos tocar juntos!', therapistTip: 'Normalize o volume dos instrumentos e ofereça modo silencioso com pistas visuais.' },
+  'rampa-maluca': { world: 'Rampa Maluca', mission: 'Qual carrinho vai descer agora?', howToPlay: 'Escolha um carrinho, prepare a rampa e veja o que acontece! Pode pedir mais uma rodada.', therapistTip: 'Use pausas intencionais para abrir oportunidades de pedidos, sem exigir fala.' },
+  'lanche-do-urso': { world: 'Lanche do Urso', mission: 'Nosso ursinho precisa de cuidado!', howToPlay: 'Veja como o urso está e escolha o que pode ajudar: comida, água, limpeza ou descanso. Vamos cuidar dele juntos!', therapistTip: 'Amplie brincadeiras simbólicas com narrativas criadas pela criança.' },
+  'minimundos': { world: 'MiniMundos', mission: 'Entre em um mundinho cheio de possibilidades!', howToPlay: 'Explore os ambientes, mova objetos e descubra pequenas missões. Você pode criar sua própria história!', therapistTip: 'Abra espaço para brincar livre, sem pontuação obrigatória.' },
+  'torre-derruba': { world: 'Torre Derruba', mission: 'Vamos construir uma torre!', howToPlay: 'Coloque os blocos, um por um, e veja a torre crescer. Depois, se quiser, derrube e comece outra!', therapistTip: 'Configure gravidade e tolerância da colisão para reduzir erros motores.' },
+  'causa-efeito': { world: 'Jardim de Luzes', mission: 'Um toque pode mudar o jardim!', howToPlay: 'Toque, segure ou arraste as coisas na tela para descobrir pequenas surpresas. Explore no seu ritmo!', therapistTip: 'Mantenha consequências imediatas, previsíveis e sensorialmente reguláveis.' },
+  'circuito-executivo': { world: 'Circuito Executivo', mission: 'O robô Bip precisa da sua estratégia!', howToPlay: 'Você vai encontrar desafios de atenção, troca de regras e memória. Escute a regra de cada etapa antes de escolher.', therapistTip: 'Não confunda tempo motor e impulsividade; registre acertos e omissões separadamente.' },
+  'missao-independencia': { world: 'Missão Independência', mission: 'Vamos resolver desafios do dia a dia!', howToPlay: 'Escolha uma missão, observe a situação e organize as ações para concluí-la. As pistas podem ajudar quando precisar.', therapistTip: 'Planeje prática fora da tela e generalização funcional.' },
+  'pequeno-chef': { world: 'Pequeno Chef', mission: 'Uma receita gostosa começa com um plano!', howToPlay: 'Escolha os ingredientes, acompanhe as etapas e prepare a receita no seu ritmo. Pode pedir uma dica se precisar!', therapistTip: 'Não promova exposição alimentar forçada; respeite preferências e segurança.' },
+  'historia-ordem': { world: 'História em Ordem', mission: 'O que aconteceu primeiro?', howToPlay: 'Observe as imagens, descubra a ordem dos acontecimentos e organize a história. Depois conte-a do seu jeito!', therapistTip: 'Aceite narrativas coerentes alternativas quando a sequência permitir.' },
+  'mercadinho-da-esquina': { world: 'Mercadinho da Esquina', mission: 'Hora de fazer compras!', howToPlay: 'Confira sua lista, escolha os produtos e veja como usar o dinheiro para pagar. Confira o troco com calma!', therapistTip: 'Personalize valores reais e complexidade de troco; simule sem coletar dados financeiros.' },
+  'passo-a-passo': { world: 'Passo a Passo', mission: 'Uma tarefa fica mais fácil em etapas!', howToPlay: 'Veja qual é o próximo passo, complete uma etapa de cada vez e acompanhe seu progresso. Peça ajuda sempre que quiser.', therapistTip: 'Vincule os passos à análise de tarefas individual e ao contexto natural.' },
+  'quadro-de-conquistas': { world: 'Quadro de Conquistas', mission: 'Vamos acompanhar o que você conquistou!', howToPlay: 'Veja as metas combinadas com seu profissional e acompanhe os símbolos conquistados. Cada passo importa!', therapistTip: 'Nunca remova fichas já conquistadas como punição; escolha metas alcançáveis.' },
+  'escape-room-kids': { world: 'Escape Room Kids', mission: 'Um mistério precisa de boas pistas!', howToPlay: 'Explore a sala, toque nos objetos e procure pistas. Resolva os desafios com calma. Você pode pedir ajuda quando precisar.', therapistTip: 'Ofereça navegação por toque sem precisão 3D e opção de desativar limite de tempo.' },
+  'vida-online': { world: 'Vida Online', mission: 'Faça escolhas seguras no mundo digital!', howToPlay: 'Explore o celular fictício, leia mensagens e situações de redes sociais. Antes de agir, pense nas possibilidades e peça ajuda quando precisar.', therapistTip: 'Não solicite senhas nem dados reais; incentive conversa sobre privacidade e consentimento.' },
